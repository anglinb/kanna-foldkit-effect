{
  "name": "kanna-code",
  "type": "module",
  "version": "0.82.1",
  "description": "A beautiful web UI for Claude Code",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "chat",
    "ui",
    "agent",
    "anthropic",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakemor/kanna.git"
  },
  "bin": {
    "kanna": "./bin/kanna"
  },
  "packageManager": "bun@1.3.5",
  "files": [
    "bin/",
    "dist/server/",
    "dist/client/",
    "dist/export-viewer/"
  ],
  "engines": {
    "bun": ">=1.3.5"
  },
  "scripts": {
    "build": "bun run build:client && bun run build:export-viewer && bun run build:server",
    "build:client": "vite build",
    "build:export-viewer": "vite build --config vite.export-viewer.config.ts",
    "build:server": "bun run ./scripts/build-server.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "prepare:export-viewer-release-assets": "bun run ./scripts/prepare-export-viewer-release-assets.ts",
    "check": "tsc --noEmit && bun run build:client && bun run build:export-viewer && bun run build:demo && bun run build:server",
    "dev": "bun run ./scripts/dev.ts",
    "dev:cloud": "KANNA_DEVBOX_UI=1 bun run ./scripts/dev.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5174",
    "dev:server": "bun run ./scripts/dev-server.ts --no-open --port 5175",
    "install:dev": "bun install && bun run build && bun install -g .",
    "start": "bun run ./src/server/cli.ts",
    "test": "bun test",
    "typecheck": "flock /tmp/kanna-tsc.lock env NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "react-free": "bun run ./scripts/foldkit/react-free.ts",
    "demo:smoke": "bun run build:demo && bun run ./scripts/foldkit/demo-smoke.ts",
    "e2e": "bun run ./scripts/foldkit/e2e/run.ts",
    "test:cloud": "bun test ./src/server/cloud/wire.e2e.ts",
    "parity": "bun run ./scripts/parity/run.ts",
    "parity:coverage": "bun run ./scripts/parity/coverage.ts",
    "parity:selfcheck": "bun run ./scripts/parity/run.ts --selfcheck && bun run ./scripts/parity/run.ts --selfcheck --inject-css '.text-muted-foreground{letter-spacing:.02em}' --expect-fail",
    "prepublishOnly": "bun run build",
    "smoke:package": "bun run ./scripts/smoke-package.ts"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "0.73.1",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "cloudflared": "^0.7.1",
    "mime-types": "3.0.2"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.277",
    "@anthropic-ai/sdk": "^0.123.0",
    "@cloudflare/workers-types": "5.20261027.1",
    "@effect/platform-browser": "4.0.5",
    "@effect/platform-bun": "4.0.5",
    "@floating-ui/dom": "1.8.0",
    "@foldkit/ui": "0.169.0",
    "@foldkit/vite-plugin": "0.28.0",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pierre/diffs": "^1.1.12",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "latest",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "command-score": "^0.1.2",
    "default-shell": "^2.2.0",
    "effect": "4.0.5",
    "file-type": "^22.0.0",
    "foldkit": "0.169.0",
    "html-url-attributes": "^3",
    "lucide": "0.562.0",
    "openai": "^6.34.0",
    "parse5": "8.0.1",
    "pixelmatch": "7",
    "playwright": "1.64.1",
    "pngjs": "7",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11",
    "remark-rehype": "^11",
    "smol-toml": "^1.9.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "typebox": "^1.3.6",
    "typescript": "5.8.3",
    "unified": "^11",
    "unist-util-visit": "^5",
    "uqr": "^0.1.3",
    "vite": "^6.0.0",
    "wrangler": "4.153.0",
    "zod": "^4.6.5"
  }
}
